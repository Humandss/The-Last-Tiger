  logoSprite: {fileID: 0}
  logoSize: 65
  classification: "\uAE34\uAE09 \uC791\uC804 \uBCF4\uACE0\uC11C \u2014 \uB3C5\uC77C
    \uAD6D\uBC29\uAD70 \uC81C4\uAE30\uAC11\uAD70"
  missionName: "\uC791\uC804\uBA85 : \uCD5C\uD6C4\uC758 \uBC29\uD328"
  dateLocation: "1944\uB144 7\uC6D4 12\uC77C  /  \uBCA8\uB77C\uB8E8\uC2A4, \uBBFC\uC2A4\uD06C
    \uADFC\uBC29"
  situationLines:
  - "\uC544\uAD70 \uAE30\uAC11 \uC804\uB825 \uAD34\uBA78. \uC804\uC7A5 \uC794\uC874
    \uCC28\uB7C9 : 1\uB7C9."
  - "\uC18C\uB828 \uC81C5\uADFC\uC704 \uC804\uCC28\uAD70 \uAE30\uAC11 \uC5EC\uB2E8,
    \uC794\uC874 \uB3C5\uC77C\uAD70 \uD3EC\uC704 \uC12C\uBA78 \uC791\uC804 \uAC1C\uC2DC."
  - "\uC7AC\uC815\uBE44 \uBC0F \uD6C4\uD1F4\uB97C \uC704\uD55C \uC2DC\uAC04 \uD655\uBCF4\uAC00
    \uC808\uBC15\uD558\uB2E4."
  objectives:
  - "\uC801 \uAE30\uAC11 \uC120\uBD09\uB300 \uAE30\uC2B5 \uD0C0\uACA9"
  - "\uC544\uAD70 \uD6C4\uD1F4 \uC644\uB8CC \uC2DC\uAE4C\uC9C0 \uC804\uC120 \uACE0\uC218"
  - "\uC0DD\uD658 \uAC00\uB2A5 \uC2DC \uD6C4\uD1F4\uD558\uB77C"
  remarks:
  - speaker: "\uC804\uCC28\uC7A5"
    line: "\uC6B0\uB9AC\uAC00 \uBC84\uD168\uC57C \uB188\uB4E4\uC774 \uC0B0\uB2E4."
    pauseAfter: 2.8
  - speaker: "\uC804\uCC28\uC7A5"
    line: "\uC5F0\uB8CC\uB3C4, \uD3EC\uD0C4\uB3C4 \uC5BC\uB9C8 \uC5C6\uC5B4. \uC2E0\uC911\uD558\uAC8C
      \uC3F4\uB77C."
    pauseAfter: 3
  - speaker: "\uC804\uCC28\uC7A5"
    line: "...\uCD9C\uACA9\uD55C\uB2E4."
    pauseAfter: 1.8
  startButtonText: "\uCD9C\uACA9"
  transitionDate: "1944\uB144 7\uC6D4 12\uC77C"
  transitionLocation: "\uBCA8\uB77C\uB8E8\uC2A4, \uBBFC\uC2A4\uD06C \uADFC\uBC29"
  transitionCommander: Unknown
  orderTitle: "\uAE34\uAE09 \uC791\uC804 \uC9C0\uB839"
  orderBody: "[\uC0C1\uD669]\n\uD604\uC7AC \uC801 \uAE30\uC815\uCC30\uAE30\uAC11\uBD80\uB300 
    \uC804\uBA78 \uD655\uC778\n<Pz.Aufkl.Abt. 5 \uCD94\uAC00 \uBCF4\uACE0> \u2014
    \uBD81 \uBC29\uBA74 \uC801 T-34 \uB2E4\uC218 \uD3EC\uCC29.\n\uD604\uC7AC \uD6C4\uBC29
    \uC99D\uAC15\uB41C \uC801 \uC8FC\uB825 \uAE30\uAC11\uBD80\uB300\uAC00 \uD574\uB2F9
    \uC804\uC120 \uB3CC\uD30C \uC608\uC0C1\uB428.\n\uD574\uB2F9 \uAE30\uAC11\uBD80\uB300\uC5D0
    \uC801\uAD70 \uC2E0\uD615 \uC804\uCC28 \uBC30\uCE58 \uAC00\uB2A5\uC131 \uC788\uC74C.
    \n\n[\uBAA9\uD45C]\n\uC801\uAD70 \uC8FC\uB825 \uAE30\uAC11 \uBD80\uB300 \uACA9\uBA78.\n\uACA9\uBA78
    \uC644\uB8CC \uD6C4 \uC9C0\uC815\uB41C \uACF3\uC73C\uB85C \uC774\uB3D9\uD560
    \uAC83. \uC774\uC0C1."
  orderConfirm: "\uBA85\uB839 \uC218\uB839"
